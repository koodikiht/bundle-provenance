{
  "name": "bundle-provenance",
  "version": "0.1.0",
  "description": "Post-build binary and client bundle supply-chain auditor (Electron Fuses, ASAR Pickle, SourceMap v3, PurlDB and CycloneDX v1.6)",
  "license": "MIT",
  "author": "Mark (malfunctionAI) <contact@koodikiht.dev>",
  "homepage": "https://github.com/koodikiht/bundle-provenance",
  "repository": {
    "type": "git",
    "url": "https://github.com/koodikiht/bundle-provenance.git"
  },
  "type": "module",
  "bin": {
    "bundle-provenance": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/bundle-provenance"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.1.0"
  },
  "keywords": [
    "sbom",
    "cyclonedx",
    "purl",
    "asar",
    "electron-fuses",
    "sourcemap",
    "supply-chain-security",
    "cra",
    "sarif"
  ]
}
